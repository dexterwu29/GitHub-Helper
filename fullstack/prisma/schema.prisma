generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              BigInt   @id @default(autoincrement())
  githubUserId    BigInt   @unique @map("github_user_id")
  githubLogin     String   @map("github_login")
  githubAvatarUrl String?  @map("github_avatar_url")
  email           String?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  apiKeys      UserApiKey[]
  repositories Repository[]

  @@index([githubLogin])
  @@map("users")
}

model UserApiKey {
  id             BigInt   @id @default(autoincrement())
  userId         BigInt   @map("user_id")
  provider       String
  encryptedKey   String   @map("encrypted_key")
  keyFingerprint String   @map("key_fingerprint")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  configs TranslationConfig[]

  @@unique([userId, provider, keyFingerprint])
  @@index([userId, provider])
  @@map("user_api_keys")
}

model Repository {
  id             BigInt   @id @default(autoincrement())
  ownerGithubId  BigInt   @map("owner_github_id")
  githubRepoId   BigInt   @unique @map("github_repo_id")
  fullName       String   @map("full_name")
  ownerLogin     String   @map("owner_login")
  repoName       String   @map("repo_name")
  defaultBranch  String   @map("default_branch")
  installationId BigInt   @map("installation_id")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  owner            User               @relation(fields: [ownerGithubId], references: [id], onDelete: Cascade)
  config           TranslationConfig?
  trackedDocuments TrackedDocument[]
  jobs             TranslationJob[]
  pullRequests     PullRequest[]
  webhookDeliveries WebhookDelivery[]

  @@index([ownerGithubId])
  @@index([fullName])
  @@map("repositories")
}

model TranslationConfig {
  id                BigInt   @id @default(autoincrement())
  repoId            BigInt   @unique @map("repo_id")
  baseLanguage      String   @map("base_language")
  targetLanguages   Json     @default("[]") @map("target_languages")
  outputDir         String   @default("_i18n") @map("output_dir")
  readmeLinksEnabled Boolean @default(true) @map("readme_links_enabled")
  runMode           String   @map("run_mode")
  userApiKeyId      BigInt?  @map("user_api_key_id")
  enabled           Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  repo       Repository  @relation(fields: [repoId], references: [id], onDelete: Cascade)
  userApiKey UserApiKey? @relation(fields: [userApiKeyId], references: [id], onDelete: SetNull)

  @@map("translation_configs")
}

model TrackedDocument {
  id              BigInt   @id @default(autoincrement())
  repoId          BigInt   @map("repo_id")
  sourcePath      String   @map("source_path")
  targetLanguages Json     @default("[]") @map("target_languages")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  repo Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@unique([repoId, sourcePath])
  @@index([repoId, isActive])
  @@map("tracked_documents")
}

model TranslationJob {
  id              BigInt    @id @default(autoincrement())
  repoId          BigInt    @map("repo_id")
  triggerType     String    @map("trigger_type")
  status          String
  dedupeKey       String?   @map("dedupe_key")
  sourceCommitSha String?   @map("source_commit_sha")
  payload         Json      @default("{}") @db.JsonB
  retryCount      Int       @default(0) @map("retry_count")
  maxRetry        Int       @default(2) @map("max_retry")
  errorMessage    String?   @map("error_message")
  startedAt       DateTime? @map("started_at") @db.Timestamptz
  finishedAt      DateTime? @map("finished_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  repo  Repository           @relation(fields: [repoId], references: [id], onDelete: Cascade)
  items TranslationJobItem[]
  prs   PullRequest[]

  @@index([repoId, status, createdAt(sort: Desc)])
  @@map("translation_jobs")
}

model TranslationJobItem {
  id             BigInt   @id @default(autoincrement())
  jobId          BigInt   @map("job_id")
  repoId         BigInt   @map("repo_id")
  sourcePath     String   @map("source_path")
  targetLanguage String   @map("target_language")
  outputPath     String   @map("output_path")
  status         String
  attempt        Int      @default(0)
  errorMessage   String?  @map("error_message")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  job TranslationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, sourcePath, targetLanguage])
  @@index([jobId, status])
  @@index([repoId, sourcePath])
  @@map("translation_job_items")
}

model PullRequest {
  id         BigInt   @id @default(autoincrement())
  repoId     BigInt   @map("repo_id")
  jobId      BigInt   @map("job_id")
  prNumber   Int      @map("pr_number")
  prUrl      String   @map("pr_url")
  headBranch String   @map("head_branch")
  baseBranch String   @map("base_branch")
  status     String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  repo Repository     @relation(fields: [repoId], references: [id], onDelete: Cascade)
  job  TranslationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([repoId, prNumber])
  @@index([repoId, status])
  @@map("pull_requests")
}

model WebhookDelivery {
  id              BigInt    @id @default(autoincrement())
  deliveryId      String    @unique @map("delivery_id")
  eventType       String    @map("event_type")
  repoId          BigInt?   @map("repo_id")
  payload         Json      @db.JsonB
  processedStatus String    @map("processed_status")
  errorMessage    String?   @map("error_message")
  receivedAt      DateTime  @default(now()) @map("received_at") @db.Timestamptz
  processedAt     DateTime? @map("processed_at") @db.Timestamptz

  repo Repository? @relation(fields: [repoId], references: [id], onDelete: SetNull)

  @@index([eventType, receivedAt(sort: Desc)])
  @@map("webhook_deliveries")
}
