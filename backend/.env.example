# ========== 应用 ==========
APP_ENV=local
APP_PORT=3800
APP_BASE_URL=http://localhost:3800
FRONTEND_URL=http://localhost:3000

# ========== JWT ==========
JWT_SECRET=your-jwt-secret-change-me-to-random-string

# ========== 数据库（Neon PostgreSQL） ==========
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/github_helper?sslmode=require

# ========== GitHub App ==========
GITHUB_APP_ID=123456
GITHUB_APP_CLIENT_ID=Iv1.xxxxxxxxxxxx
GITHUB_APP_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# ========== OpenRouter ==========
OPENROUTER_API_KEY_PLATFORM=sk-or-v1-platform-key-here
OPENROUTER_DEFAULT_MODEL=google/gemini-2.0-flash-001

# ========== 加密（用于 API Key 加密存储） ==========
ENCRYPTION_KEY=32-bytes-hex-string-change-me-00000000000000000000000000000000
